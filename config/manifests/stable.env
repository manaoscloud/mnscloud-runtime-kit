# Homologated defaults for shared runtime installers.

MNSCLOUD_NGINX_CHANNEL=stable
MNSCLOUD_FLUTTER_REPO_URL=https://github.com/flutter/flutter.git
MNSCLOUD_FLUTTER_CHANNEL=stable
MNSCLOUD_FLUTTER_DIR=/opt/flutter
MNSCLOUD_FLUTTER_BUILD_PROFILE=web
MNSCLOUD_FLUTTER_RUN_USER=
MNSCLOUD_FLUTTER_HOME=/var/lib/mnscloud-runtime-kit/flutter
MNSCLOUD_FLUTTER_PRECACHE_WEB=true
MNSCLOUD_DENO_VERSION=2.8.1
MNSCLOUD_DENO_INSTALL_DIR=/usr/local/deno
MNSCLOUD_NODE_MAJOR_VERSION=24
MNSCLOUD_DOCKER_CHANNEL=stable
MNSCLOUD_RABBITMQ_CHANNEL=stable
